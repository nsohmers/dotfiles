#!/usr/bin/env bash
# Fuzzy-find a project directory and create-or-attach a same-named tmux session for it.
# Bound to `prefix+f` in .tmux.conf.
#
# Edit SEARCH_ROOTS below to match where you actually keep projects.
SEARCH_ROOTS=(~/dotfiles ~/Documents)

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(fd . "${SEARCH_ROOTS[@]}" --type d --max-depth 3 --hidden --exclude .git 2>/dev/null | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
session_name="$selected_name"

# Session names are global, so disambiguate projects with the same basename.
if tmux has-session -t="$session_name" 2>/dev/null; then
    session_path=$(tmux display-message -p -t="$session_name" '#{pane_current_path}')
    if [[ "$session_path" != "$selected" ]]; then
        session_name="$(printf '%s' "$selected" | sed "s#^$HOME/##; s#[^[:alnum:]_-]#_#g")"
    fi
fi

if [[ -z $TMUX ]] && ! tmux list-sessions >/dev/null 2>&1; then
    tmux new-session -s "$session_name" -c "$selected"
    exit 0
fi

if ! tmux has-session -t="$session_name" 2>/dev/null; then
    tmux new-session -ds "$session_name" -c "$selected"
fi

if [[ -z $TMUX ]]; then
    tmux attach-session -t "$session_name"
else
    tmux switch-client -t "$session_name"
fi
