#!/usr/bin/env bash
# Fuzzy-find a project directory and create-or-attach a same-named tmux session for it.
# Bound to `prefix+f` in .tmux.conf.
#
# Edit SEARCH_ROOTS below to match where you actually keep projects.
SEARCH_ROOTS=(~/dotfiles ~/Documents)

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(fd . "${SEARCH_ROOTS[@]}" --type d --max-depth 3 --hidden --exclude .git 2>/dev/null | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s "$selected_name" -c "$selected"
    exit 0
fi

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected"
fi

if [[ -z $TMUX ]]; then
    tmux attach-session -t "$selected_name"
else
    tmux switch-client -t "$selected_name"
fi
