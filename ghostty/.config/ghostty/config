# Font — p10k needs a Nerd Font for the powerline glyphs
font-family = MesloLGS NF
font-size = 15

theme = Catppuccin Mocha

background-opacity = 0.9
background-blur-radius = 20

window-padding-x = 10
window-padding-y = 10
window-decoration = true
macos-titlebar-style = tabs

cursor-style = block

# without this, macOS composes Option+letter into accented/special characters
# instead of sending it as Alt, which is what tmux's M-h/j/k/l pane nav and
# vim-tmux-navigator's <A-h/j/k/l> mappings both rely on
macos-option-as-alt = true

shell-integration = zsh
shell-integration-features = cursor,sudo,title

copy-on-select = clipboard
scrollback-limit = 10000
confirm-close-surface = false

# without this, closing a window's last surface leaves Ghostty running with zero
# windows (visible as repeated "ghostty" processes piling up in Activity Monitor) —
# this makes it quit regardless of *how* the window was closed (Cmd+W, red button,
# AeroSpace's alt-q), unlike AeroSpace's own close --quit-if-last-window flag which
# only helps when you specifically use alt-q
quit-after-last-window-closed = true
